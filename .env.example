# RepoPilot Stage 1-3 local development; Stage 4 Task 1 freezes these Dense defaults.
# Baseline capture is an evaluation CLI; no new production retrieval switches yet.
# Copy to .env only on first setup; keep existing .env values and real keys private.
API_CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

# Default provider: local Ollama ("ollama" is a non-secret placeholder).
LLM_PROVIDER=openai_compatible
LLM_API_KEY=ollama
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:0.5b
LLM_TIMEOUT_SECONDS=60

# Official OpenAI alternative (put the real key only in .env):
# LLM_PROVIDER=openai
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=

# Stage 2: local Qdrant; the Compose helper binds the HTTP port to loopback.
# Use a different collection and reindex when changing embedding model/endpoint.
# Collection dimension is measured from actual embeddings, never configured here.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=repopilot_code
QDRANT_TIMEOUT_SECONDS=5
QDRANT_HTTP_PORT=6333

# Stage 2: independent embedding model (pull it with Ollama first).
# These settings never fall back to LLM_*; the chat model generates text.
# Local defaults send chunks/queries to Ollama on this machine. A remote
# EMBEDDING_BASE_URL sends that content to the chosen external model service.
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_API_KEY=ollama
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_TIMEOUT_SECONDS=120
EMBEDDING_BATCH_SIZE=16

# Read-only scanning under the fixed workspaces/ root, with byte/entry budgets.
# Fixed filename/directory exclusions live in app/repository/ignore.py.
REPOSITORY_MAX_FILE_BYTES=1048576
REPOSITORY_MAX_ENTRIES=10000
REPOSITORY_MAX_TOTAL_BYTES=20971520

# Simple line windows; overlap must be smaller than CHUNK_LINES.
# CHUNK_MAX_CHARACTERS counts Unicode characters, not tokens or raw file bytes.
CHUNK_LINES=60
CHUNK_OVERLAP_LINES=10
CHUNK_MAX_CHARACTERS=8192
CHUNK_MAX_CHUNKS=10000

# Bound all prepared chunks/vectors before repository point replacement.
# The vector budget counts numeric coordinates, not bytes of memory.
INDEXING_MAX_TEXT_CHARACTERS=2000000
INDEXING_MAX_VECTOR_VALUES=2000000

# Stage 3: serialized Context Builder budget, including metadata and separators.
# This bounds source records and Unicode characters; it is not a token budget.
# Keep source/index/model/TopK/Context settings fixed when comparing retrieval runs.
MAX_CONTEXT_CHUNKS=5
MAX_CONTEXT_CHARACTERS=16000
